{
  "name": "cool-timeline-block",
  "version": "1.2.2",
  "description": "Showcase your story or company history,events,process steps and Roadmap in precise and elegant way using powerful and advance Gutenberg Timeline Block",
  "author": "Cool Timeline",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "wp-scripts build --output-path=./dist",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start --output-path=./dist",
    "build:ctl": "wp-scripts build --env target=ctl && node build-tools/copy-ctl-assets.js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^25.4.0",
    "sass": "^1.90.0",
    "sass-embedded": "^1.90.0",
    "sass-loader": "^16.0.5",
    "webfontloader": "^1.6.28"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "memize": "^1.1.0",
    "react-icons": "^5.4.0",
    "react-is": "^18.3.1",
    "react-select": "^5.7.1",
    "styled-components": "^5.3.9"
  }
}
